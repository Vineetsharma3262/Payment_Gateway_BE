# ─────────────────────────────────────────────────────────────────────────────
# PayCo backend — environment template.
# Copy to `.env` for local development. NEVER commit real values.
# staging/production: secrets come from AWS Secrets Manager (SECRETS_PROVIDER=aws);
# only non-secret configuration is set through environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug
# Public origin of this API and of PayCo-hosted checkout / payment links (PRD 4: pay.payco.com)
APP_PUBLIC_BASE_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:3001/checkout
# Comma-separated exact origins allowed by CORS (dashboard, checkout). No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# PostgreSQL (authoritative store for all financial records)
DATABASE_URL=postgresql://payco:payco_dev_password@localhost:5432/payco?schema=public

# Redis (rate limiting, short-lived coordination). Optional in development/test.
REDIS_URL=redis://localhost:6379

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Dashboard sessions (JWT access token + rotating opaque refresh token)
DASHBOARD_BASE_URL=http://localhost:3001
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Onboarding documents / reports (S3, SSE-KMS). Empty = local dev stub (no real uploads).
DOCUMENTS_BUCKET=
DOCUMENTS_KMS_KEY_ID=

# Payment provider used for new merchant accounts: razorpay | stripe_connect | fake
# `fake` is rejected in staging/production.
PAYMENT_PROVIDER_DEFAULT=fake
RAZORPAY_API_BASE_URL=https://api.razorpay.com
PROVIDER_HTTP_TIMEOUT_MS=10000

# AWS
AWS_REGION=us-east-1
# Optional locally; the outbox relay worker requires it.
SQS_OUTBOX_QUEUE_URL=
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
# Worker queues (each worker refuses to start until its phase is implemented)
PROVIDER_EVENTS_QUEUE_URL=
PROVIDER_SYNC_QUEUE_URL=
WEBHOOK_DELIVERY_QUEUE_URL=
SETTLEMENT_IMPORT_QUEUE_URL=
RECONCILIATION_QUEUE_URL=
NOTIFICATION_QUEUE_URL=

# Secret resolution: env (development/test only) | aws
SECRETS_PROVIDER=env
# Prefix for secret names in AWS Secrets Manager, e.g. payco/staging
SECRETS_NAMESPACE=payco/local

# ── Secrets (SECRETS_PROVIDER=env only) ──────────────────────────────────────
# Secret name `x/y-z` is read from env var SECRET_X_Y_Z. Dev placeholders only.
SECRET_API_KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# HS256 signing key for dashboard access tokens (>= 32 chars)
SECRET_JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-0123456789
# JSON: {"active":"k1","keys":{"k1":"<base64 32 bytes>"}} — generate: openssl rand -base64 32
SECRET_FIELD_ENCRYPTION_KEYS={"active":"dev1","keys":{"dev1":"ZGV2LW9ubHktZmllbGQta2V5LTMyLWJ5dGVzLWxvbmc="}}
# JSON: {"keyId":"...","keySecret":"...","webhookSecret":"..."} (Razorpay test mode keys)
SECRET_RAZORPAY_TEST=
SECRET_RAZORPAY_LIVE=

# ── Transactional email (Resend) ─────────────────────────────────────────────
# `log` writes to the server log; `resend` delivers via resend.com.
EMAIL_PROVIDER=log
# "Display Name <sender@verified-domain.com>". `onboarding@resend.dev` works
# out of the box; verify a custom domain on Resend before production.
EMAIL_FROM=Nimbus <onboarding@resend.dev>
EMAIL_REPLY_TO=
# Resend API key — fill in locally; never commit the real value.
SECRET_RESEND_API_KEY=
